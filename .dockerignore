# ── Version control ───────────────────────────────────────────────────────────
.git
.github
.gitignore

# ── Python cache & compiled files ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# ── Virtual environments ──────────────────────────────────────────────────────
senv/
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ─────────────────────────────────────────────────────────────────────────────
# PROJECT-SPECIFIC — large / not needed for inference
# ─────────────────────────────────────────────────────────────────────────────

# ── Raw dataset & Training Outputs (Gigabytes of data) ──────────────────────
data/
xview_yolo/

# ── Jupyter notebooks & Docs ────────────────────────────────────────────────
notebooks/
*.ipynb
docs/
*.md
*.pdf
*.txt
!requirements.txt

# ── Intermediate pipeline artifacts ──────────────────────────────────────────
artifacts/

# ── Scripts not needed at runtime ────────────────────────────────────────────
main.py

# ── Trained model weights ─────────────────────────────────────────────────────
# Only allow inference weights if present; ignore all others to save space
*.pt
*.pth
*.safetensors
*.bin
*.engine
*.onnx

# Allow the fallback / optimized weights required by application.py
!best-v26.pt
!best.pt
!best.onnx

# ── Runtime-generated directories (created fresh by Dockerfile) ───────────────
logs/
uploads/

# ── IDE / editor / agent files ────────────────────────────────────────────────
.vscode/
.idea/
.gemini/
.agents/
.cursor/
*.code-workspace

# ── OS metadata ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*
*.env
.envrc

# ── Type checkers / linters cache ────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
.nox/

# ── Test files ────────────────────────────────────────────────────────────────
tests/
test_*.py
*_test.py

# ── Build / dist artifacts ───────────────────────────────────────────────────
dist/
build/
*.egg-info/
.eggs/

# ── DVC ───────────────────────────────────────────────────────────────────────
.dvc/
.dvcignore

# ── Additional dataset / caching ──────────────────────────────────────────────
datasets/
chips/
tiles/
images/
labels/
annotations/
*.tif
*.tiff
*.geotiff
*.geojson

# ── Logs & Checkpoints ────────────────────────────────────────────────────────
runs/
weights/
checkpoints/
runs_tensorboard/
mlruns/
wandb/

# ── Cache & Temp ──────────────────────────────────────────────────────────────
~/.cache/
.torch/
ultralytics/
tmp/
temp/
debug/
samples/
demo/
output/

# ── Render config ─────────────────────────────────────────────────────────────
render.yaml
Dockerfile
.dockerignore