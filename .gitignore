# ─────────────────────────────────────────────────────────────────────────────
# PROJECT-SPECIFIC
# ─────────────────────────────────────────────────────────────────────────────

# ── Raw xView dataset (very large GeoTIFF files) ──────────────────────────────
data/

# ── YOLO training run outputs (chips, labels, training weights) ───────────────
xview_yolo/

# ── Temporary upload directory (created at runtime by Flask) ─────────────────
uploads/

# ── Runtime logs (timestamped .log files generated by logger.py) ─────────────
logs/
*.log

# ── Trained model weights ─────────────────────────────────────────────────────
# best.pt is tracked via Git LFS or stored externally (too large for regular git)
best.pt

# ── Exported model formats (TensorRT engine, ONNX) ────────────────────────────
# These are large binary artifacts generated from best.pt
*.engine
*.onnx

# ── Intermediate pipeline artifacts ──────────────────────────────────────────
# raw_annotations.csv (~18 MB), results.csv, curve PNGs generated during training
/artifacts/

# ── Sphinx / mkdocs docs build ────────────────────────────────────────────────
docs/_build/
/site

# ── Output directory (if used) ───────────────────────────────────────────────
output/